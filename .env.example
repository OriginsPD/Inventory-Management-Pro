# Database
POSTGRES_USER=ims_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=ims_pro_db
DATABASE_URL=postgres://ims_user:replace-with-a-strong-database-password@db:5432/ims_pro_db

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3002
IMS_BOOTSTRAP_ADMIN_EMAIL=
IMS_BOOTSTRAP_ADMIN_PASSWORD=
IMS_ENABLE_DEV_AUTH=false
IMS_DEV_ADMIN_EMAIL=
IMS_DEV_ADMIN_PASSWORD=

# Backend
PORT=3000
HOSTNAME=0.0.0.0
CORS_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
ENABLE_SWAGGER=false

# Frontend (Vite)
VITE_API_URL=http://localhost:3002
