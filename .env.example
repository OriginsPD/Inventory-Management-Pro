# Database
POSTGRES_USER=ims_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=ims_pro_db
DATABASE_URL=postgres://ims_user:replace-with-a-strong-database-password@localhost:5433/ims_pro_db

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret-minimum
BETTER_AUTH_URL=http://localhost:3002
IMS_BOOTSTRAP_ADMIN_EMAIL=
IMS_BOOTSTRAP_ADMIN_PASSWORD=
IMS_ENABLE_DEV_AUTH=false
IMS_DEV_ADMIN_EMAIL=
IMS_DEV_ADMIN_PASSWORD=

# Server
PORT=3002
HOSTNAME=0.0.0.0
CORS_ORIGIN=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3001
ENABLE_SWAGGER=false

# Web (TanStack Start)
VITE_SERVER_URL=http://localhost:3002
# SSR inside Docker web container (docker-compose sets this automatically)
# SERVER_INTERNAL_URL=http://server:3002
