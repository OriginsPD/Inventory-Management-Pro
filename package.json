{
  "name": "ims_pro",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "better-auth": "1.6.23",
      "evlog": "^2.19.2",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @ims_pro/db db:push",
    "db:studio": "bun run --filter @ims_pro/db db:studio",
    "db:generate": "bun run --filter @ims_pro/db db:generate",
    "db:migrate": "bun run --filter @ims_pro/db db:migrate",
    "db:start": "bun run --filter @ims_pro/db db:start",
    "db:watch": "bun run --filter @ims_pro/db db:watch",
    "db:stop": "bun run --filter @ims_pro/db db:stop",
    "db:down": "bun run --filter @ims_pro/db db:down",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@ims_pro/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@ims_pro/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
