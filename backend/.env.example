# Database connection string for Postgres / Neon DB.
# Example: postgres://[user]:[password]@[neon-project].neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://ims_user:replace-with-a-strong-database-password@localhost:5433/ims_pro_db
PORT=3002
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3002
TRUSTED_ORIGINS=http://localhost:5173
ENABLE_SWAGGER=false

# Optional first-run bootstrap. Leave empty after creating the first admin.
IMS_BOOTSTRAP_ADMIN_EMAIL=
IMS_BOOTSTRAP_ADMIN_PASSWORD=

# Optional local fallback auth when no database is configured.
IMS_ENABLE_DEV_AUTH=false
IMS_DEV_ADMIN_EMAIL=
IMS_DEV_ADMIN_PASSWORD=
