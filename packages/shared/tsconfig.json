{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true,
    "ignoreDeprecations": "6.0",
    "types": ["bun-types"],
    "outDir": "./dist",
    "baseUrl": "."
  },
  "include": ["src/**/*"]
}
